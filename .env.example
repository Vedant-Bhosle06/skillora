# =============================================================================
# SKILLORA — Environment Variables Template
# =============================================================================
# Copy this file to .env in each service folder as shown below.
# NEVER commit a real .env file to Git — only this .env.example file.
# =============================================================================
#
# HOW TO USE:
#   skillora-api/     → copy the [NODE API] section into skillora-api/.env
#   skillora-path-service/ → copy the [PYTHON SERVICE] section into skillora-path-service/.env
#   skillora-client/  → copy the [REACT CLIENT] section into skillora-client/.env
#
# The INTERNAL_API_KEY and MONGO_URI must be the SAME value across all services.
# =============================================================================


# =============================================================================
# [NODE API]  skillora-api/.env
# =============================================================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (one person sets this up and shares it)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/skillora_dev?retryWrites=true&w=majority

# JWT — pick any long random string for JWT_SECRET (e.g. run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Shared secret between Node API and Python service — MUST match Python service
# Generate once and share with your team (e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
INTERNAL_API_KEY=replace_with_a_shared_secret_string

# URL where the Python service is running (local dev)
PYTHON_SERVICE_URL=http://localhost:5001

# Timeout (ms) for calls from Node to the Python service
PYTHON_TIMEOUT_MS=5000


# =============================================================================
# [PYTHON SERVICE]  skillora-path-service/.env
# =============================================================================

# Same MongoDB URI as Node (Python reads the skills + skilledges collections at startup)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/skillora_dev?retryWrites=true&w=majority

# Same INTERNAL_API_KEY as Node (Python validates this header on every request except /health)
INTERNAL_API_KEY=replace_with_a_shared_secret_string

# Port the Python service listens on (used in the uvicorn start command)
PYTHON_PORT=5001

# --- Optional (defaults shown) ---
# Database name override; by default the database named in MONGO_URI is used
# MONGO_DB=skillora_dev
# Collection names (Mongoose defaults for the Skill and SkillEdge models)
# SKILLS_COLLECTION=skills
# EDGES_COLLECTION=skilledges
# Safety cap on states expanded by the search before it stops
# MAX_STATES=200000
# Alternatives must cost <= this ratio x the cheapest path
# COST_BOUND_RATIO=1.5


# =============================================================================
# [REACT CLIENT]  skillora-client/.env
# =============================================================================

# Base URL of the Node API — Vite requires the VITE_ prefix to expose to the browser
VITE_API_BASE_URL=http://localhost:5000
